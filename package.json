{
  "name": "scribeseal",
  "version": "0.1.0",
  "description": "Diff-first, conflict-aware HackMD note updates over MCP.",
  "private": true,
  "type": "module",
  "bin": {
    "scribeseal": "dist/scribeseal.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run --exclude tests/integration/live-hackmd.test.ts",
    "test:bundle": "node --experimental-strip-types tests/contract/bundled-stdio-smoke.ts",
    "test:live": "vitest run tests/integration/live-hackmd.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@hackmd/api": "2.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "diff": "9.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
